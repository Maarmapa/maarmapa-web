# ─────────────────────────────────────────────────────────────────
# maarmapa-site · variables de entorno
# Copiar a .env.local (gitignored) y completar con valores reales.
# ─────────────────────────────────────────────────────────────────

# ─── Supabase (reusable de BOYKOT) ───
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role, server-side only

# ─── Mercado Pago ───
# Obtener en https://www.mercadopago.cl/developers/panel/credentials
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxxxxxx

# ─── Khipu ───
# https://khipu.com/page/api
KHIPU_API_KEY=xxxxxxxx

# ─── x402 / Base ───
# Dirección donde se reciben los pagos USDC en Base (0x + 40 hex).
# OPCIONAL: si falta (o es inválida / la dirección cero) el server resuelve
# maarmapa.eth vía ENS en mainnet; si eso también falla, el pago USDC se
# deshabilita (503). Nunca se usa la dirección cero como receptor.
# X402_RECIPIENT_ADDRESS=0x...
# RPC opcional (público funciona, pero un endpoint propio es más rápido)
BASE_RPC_URL=https://mainnet.base.org
# RPC de Ethereum mainnet opcional para resolver ENS (se antepone a los públicos)
# ETH_MAINNET_RPC_URL=https://...
